# Copy to .env and adjust. Never commit a real .env.
NODE_ENV=development
PORT=4000
DB_PATH=./data/padosipro.db

# Generate strong values, e.g.: node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OTP_SECRET=change-me-to-another-long-random-string

# Email: "smtp" (Mailpit / any SMTP server) or "console" (prints the email in the terminal, no SMTP needed)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PadosiPro <no-reply@padosipro.local>

# Optional tuning
OTP_RESEND_COOLDOWN_SECONDS=30
BCRYPT_ROUNDS=10
