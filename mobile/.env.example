# Where the backend is reachable FROM THE DEVICE running the app.
#   Android emulator : http://10.0.2.2:4000        (this is also the default if unset)
#   iOS simulator    : http://localhost:4000
#   Real phone       : http://<your computer's LAN IP>:4000   e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
